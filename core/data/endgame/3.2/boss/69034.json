          "layer_buff": {
            "69013003": {
              "title": "",
              "desc": "· 适合<IconMap:Icon_AvatarClass_Anomaly><color=#FFAF2C>[异常]</color>特性的代理人挑战。"
            },
            "69013103": {
              "title": "",
              "desc": "· 代理人异常积蓄效率<color=#FFAF2C>提升15%</color>，对叛律孤歌造成的异常伤害<color=#FFAF2C>提升30%</color>，战斗中代理人处在[以太帷幕]状态时，叛律孤歌失衡易伤倍率<color=#FFAF2C>提升30%</color>。"
            },
            "69013104": {
              "title": "",
              "desc": "<color=#FFAF2C>[控制技]</color>期间，每次成功应对首领的攻击，可获得<color=#FFAF2C>350操作得分</color>；<color=#FFAF2C>[完美反制]</color>首领的<color=#FFAF2C>[控制技]</color>时，或招架部分招式最后一击时，可对首领造成<color=#FFAF2C>[部位破坏]</color>效果，可获得<color=#FFAF2C>750操作得分</color>。<Term:2000003></Term>期间，通过<color=#FFAF2C>[反制支援]</color>造成<color=#FFAF2C>[完美反制]</color>时，会获得该次<color=#FFAF2C>[控制技]</color>剩余的成功应对得分。最多获得5000操作得分。"
            }
          },
