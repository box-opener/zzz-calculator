        "6903901": {
          "name": "基塔布鲁",
          "stage_num": 1,
          "monster_level": 70,
          "layer_buff": {
            "69013003": {
              "title": "",
              "desc": "· 适合<IconMap:Icon_AvatarClass_Anomaly><color=#FFAF2C>[异常]</color>特性的代理人挑战。"
            },
            "69013903": {
              "title": "69013903_Title",
              "desc": "· 代理人每次对首领施加异常状态时，会给首领施加1层[残翳]，每层[残翳]会令首领受到的<color=#2BAD00>异常伤害提升7.5%</color>，受到的[乱流]伤害<color=#2BAD00>额外提升5%</color>，持续<color=#2BAD00>10秒</color>，[残翳]最多累计<color=#2BAD00>3层</color>，每层效果单独结算持续时间；<Term:2000001></Term>持续期间，首领被施加[残翳]时还会额外削减<color=#FFAF2C>[侵蚀壁垒]</color><color=#2BAD00>最大值的20%</color>，并累积<color=#2BAD00>15%的失衡值</color>（15秒内不会重复触发）；<color=#FFAF2C>[侵蚀壁垒]</color>被击破时，首领立刻获得最大层数的[残翳]；首领进入失衡状态时，会移除所有[残翳]，并施加相同层数的[裂伤]，每层[裂伤]会降低首领<color=#2BAD00>5%异常积蓄抗性</color>，并增加其<color=#2BAD00>10%失衡易伤倍率</color>；首领失衡状态结束时，移除所有[裂伤]。"
            },
            "69013904": {
              "title": "69013904_Title",
              "desc": "· 每次成功招架基塔布鲁开启[侵蚀壁垒]后的连续下砸，可获得<color=#FFAF2C>1000操作得分</color>，成功触发<Term:2000004></Term>应对最后一段下砸，可额外获得<color=#FFAF2C>1000操作得分</color>；<color=#FFAF2C>成功击破[侵蚀壁垒]</color>时，可获得<color=#FFAF2C>1500操作得分</color>。最多获得5000操作得分。"
            }
          },
