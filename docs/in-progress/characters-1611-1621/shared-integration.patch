+@dataclass(frozen=True, slots=True)
+class UnresolvedSharpenedDamageEventTemplate:
+    """Typed, Electric Sharp Damage source awaiting its settlement formula."""
+
+    ref: DamageEventTemplateRef
+    damage_dealer: CharacterId
+    element: Element
+    base_source: CurrentDefenseValueSource
+    move_id: MoveId | None
+    unresolved: Unresolved
+
+    def __post_init__(self) -> None:
+        if self.ref.damage_type is not DamageType.SHARPENED:
+            raise ValueError("UnresolvedSharpenedDamageEventTemplate requires sharpened damage")
+        if self.ref.damage_subtype is not None:
+            raise ValueError("sharpened damage template has no reviewed subtype")
+        if self.ref.element is not self.element:
+            raise ValueError("template ref element must match typed template element")
+        if self.base_source.character_id != self.damage_dealer:
+            raise ValueError("sharp-damage defense source must match the damage dealer")
+        if self.ref.skill_group is None and self.move_id is not None:
+            raise ValueError("a template with a move_id must have an explicit skill_group")
